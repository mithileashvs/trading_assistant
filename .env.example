# Copy this file to .env and fill in real values.
# NEVER commit a real .env file with credentials.

# --- Safety -----------------------------------------------------------
# BACKTEST | PAPER | LIVE.  Defaults to PAPER even if unset.
TRADING_MODE=PAPER
KILL_SWITCH=false
KILL_SWITCH_CLOSES_POSITIONS=false

# --- MT5 connection -----------------------------------------------------
# Set MT5_USE_MOCK=false only once you're running on a host with a real
# MT5 terminal installed (Windows, or Wine).
MT5_USE_MOCK=true
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# --- Symbol discovery ----------------------------------------------------
SYMBOL_CANDIDATES=XAUUSD,XAUUSDm,GOLD,GOLDm

# --- Timeframes ------------------------------------------------------------
TF_TREND=H4
TF_STRUCTURE=H1
TF_ENTRY=M15

# --- Strategy toggles ---------------------------------------------------------
STRATEGY_TREND_PULLBACK_ENABLED=true
STRATEGY_BREAKOUT_ENABLED=true
STRATEGY_MEAN_REVERSION_ENABLED=true

# --- Data freshness --------------------------------------------------------
MARKET_DATA_MAX_STALENESS_SECONDS=120

# --- Storage / logging -------------------------------------------------------
DATABASE_URL=sqlite:///./data/trading_journal.db
LOG_LEVEL=INFO
LOG_DIR=./data/logs

# --- Risk engine (all optional, shown here with their defaults) ----------------
RISK_RISK_PER_TRADE_PCT=0.5
RISK_MAX_DAILY_LOSS_PCT=2.0
RISK_MAX_WEEKLY_LOSS_PCT=5.0
RISK_MAX_OPEN_POSITIONS=1
RISK_MAX_TRADES_PER_DAY=5
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_MAX_SPREAD_POINTS=50
RISK_MAX_SLIPPAGE_POINTS=20
RISK_MIN_ACCOUNT_EQUITY=0

# --- News filter (optional) --------------------------------------------------
NEWS_CALENDAR_PATH=
NEWS_BLACKOUT_MINUTES_BEFORE=30
NEWS_BLACKOUT_MINUTES_AFTER=30

# --- AI layer (optional) -------------------------------------------------------
# Only needed for LLM-assisted NL config translation / summary polishing.
# Everything in app/ai/ works without this (rule-based + deterministic).
ANTHROPIC_API_KEY=
